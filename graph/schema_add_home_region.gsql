/*
=============================================================================
  Global Schema Modification: Add home_region to Customer Vertex
=============================================================================
*/

CREATE GLOBAL SCHEMA_CHANGE JOB add_home_region_to_customer {
  ALTER VERTEX Customer ADD ATTRIBUTE (home_region STRING DEFAULT "");
}

RUN GLOBAL SCHEMA_CHANGE JOB add_home_region_to_customer
DROP JOB add_home_region_to_customer
