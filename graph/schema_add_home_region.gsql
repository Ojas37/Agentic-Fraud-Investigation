/*
=============================================================================
  Schema Modification: Add home_region to Customer Vertex
  Enables geographic anomaly detection by comparing transaction addr1
  against the customer's primary historical billing region.
=============================================================================
*/

USE GRAPH FraudGraph

CREATE SCHEMA_CHANGE JOB add_home_region_to_customer FOR GRAPH FraudGraph {
  ALTER VERTEX Customer ADD ATTRIBUTE (home_region STRING DEFAULT "");
}

RUN SCHEMA_CHANGE JOB add_home_region_to_customer
DROP JOB add_home_region_to_customer
