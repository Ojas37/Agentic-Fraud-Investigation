/*
=============================================================================
  HHGOA Fraud Investigation Agent — TigerGraph GSQL Schema
  Version: 1.0
  Based on: README.md (HHGOA_IEEE dataset, TigerGraph × Hacker House Goa)
  
  ⚠️  SHOW TO USER BEFORE RUNNING against the live TigerGraph instance.
=============================================================================

VERTEX TYPES
  Customer        — one per customer_id (e.g. C01234)
  Card            — one per card_id (e.g. C01234-K1); a customer may have many
  Transaction     — one per TransactionID; all 393 original columns + added cols
  DeviceProfile   — deduplicated fingerprint: DeviceInfo + OS + browser + screen
  EmailDomain     — purchaser / recipient email domain node
  BillingRegion   — addr1 value (anonymised region code)
  ClosedCase      — historical fraud investigation from closed_cases_history.csv
  FraudCase       — live investigation written by the agent (case memory)

EDGE TYPES
  OWNS                Customer → Card
  MADE                Card     → Transaction
  FROM_DEVICE         Transaction → DeviceProfile   (online txns only)
  PURCHASER_EMAIL     Transaction → EmailDomain
  RECIPIENT_EMAIL     Transaction → EmailDomain
  BILLED_IN           Transaction → BillingRegion
  NEXT_TXN            Transaction → Transaction     (chronological, per card)
  CASE_INVOLVES       ClosedCase  → Transaction
  CASE_ON_CARD        ClosedCase  → Card
  CASE_CONNECTED_TO   ClosedCase  → Card            (connected cards in ring)
  LIVE_CASE_INVOLVES  FraudCase   → Transaction
  LIVE_CASE_ON_CARD   FraudCase   → Card
  LIVE_CONNECTED_CARD FraudCase   → Card
  LIVE_CONNECTED_DEV  FraudCase   → DeviceProfile
  SIMILAR_TO          FraudCase   → ClosedCase      (memory retrieval link)
=============================================================================
*/

USE GRAPH FraudGraph

/* ─────────────────────────────────────────────────────────────────────────
   VERTEX DEFINITIONS
   ───────────────────────────────────────────────────────────────────────── */

CREATE VERTEX Customer (
  PRIMARY_ID customer_id STRING,
  customer_id   STRING,
  first_seen_ts DATETIME,
  last_seen_ts  DATETIME,
  total_txn_count INT DEFAULT 0,
  total_spend_usd FLOAT DEFAULT 0.0
) WITH primary_id_as_attribute="true"


CREATE VERTEX Card (
  PRIMARY_ID card_id STRING,
  card_id       STRING,
  customer_id   STRING,
  -- card detail columns from transactions.csv
  card1         STRING,   -- issuer code
  card2         STRING,
  card3         STRING,
  card4         STRING,   -- network: visa / mastercard / american express / discover
  card5         STRING,
  card6         STRING,   -- type: credit / debit
  first_seen_ts DATETIME,
  last_seen_ts  DATETIME,
  is_blocked    BOOL DEFAULT FALSE,
  block_reason  STRING DEFAULT ""
) WITH primary_id_as_attribute="true"


CREATE VERTEX Transaction (
  PRIMARY_ID transaction_id STRING,
  -- Added columns
  transaction_id  STRING,
  customer_id     STRING,
  card_id         STRING,
  ts              DATETIME,
  channel         STRING,   -- "in_person" | "online"
  risk_score      FLOAT,

  -- Vesta core columns
  TransactionDT   INT,
  TransactionAmt  FLOAT,
  ProductCD       STRING,

  -- Card columns (denormalised for query speed)
  card1  STRING,
  card2  STRING,
  card3  STRING,
  card4  STRING,
  card5  STRING,
  card6  STRING,

  -- Billing
  addr1  STRING,   -- billing region code
  addr2  STRING,   -- billing country code (87 = home)

  -- Distances
  dist1  FLOAT,
  dist2  FLOAT,

  -- Email domains
  P_emaildomain  STRING,
  R_emaildomain  STRING,

  -- Count features C1–C14
  C1  FLOAT,  C2  FLOAT,  C3  FLOAT,  C4  FLOAT,  C5  FLOAT,
  C6  FLOAT,  C7  FLOAT,  C8  FLOAT,  C9  FLOAT,  C10 FLOAT,
  C11 FLOAT,  C12 FLOAT,  C13 FLOAT,  C14 FLOAT,

  -- Time-delta features D1–D15
  D1  FLOAT,  D2  FLOAT,  D3  FLOAT,  D4  FLOAT,  D5  FLOAT,
  D6  FLOAT,  D7  FLOAT,  D8  FLOAT,  D9  FLOAT,  D10 FLOAT,
  D11 FLOAT,  D12 FLOAT,  D13 FLOAT,  D14 FLOAT,  D15 FLOAT,

  -- Match flags M1–M9
  M1  STRING,  M2 STRING,  M3 STRING,  M4 STRING,  M5 STRING,
  M6  STRING,  M7 STRING,  M8 STRING,  M9 STRING,

  -- Vesta engineered features V1–V339 stored as a JSON blob to keep schema manageable.
  -- Critical V-features used in fraud scoring are also stored as individual attrs below.
  v_features_json  STRING DEFAULT "{}",

  -- Subset of V-features commonly cited in fraud patterns (add more as needed)
  V1   FLOAT,  V2   FLOAT,  V3   FLOAT,  V4   FLOAT,
  V12  FLOAT,  V13  FLOAT,  V14  FLOAT,
  V83  FLOAT,  V127 FLOAT,

  -- Derived / computed at load time
  is_suspicious  BOOL DEFAULT FALSE,
  in_case        BOOL DEFAULT FALSE
) WITH primary_id_as_attribute="true"


CREATE VERTEX DeviceProfile (
  PRIMARY_ID device_profile_id STRING,
  -- Composite key: DeviceInfo|id_30(OS)|id_31(browser)|id_33(screen)
  device_profile_id  STRING,
  DeviceType         STRING,   -- "mobile" | "desktop"
  DeviceInfo         STRING,   -- e.g. "SAMSUNG SM-G935F Build/NRD90M"
  os                 STRING,   -- id_30
  browser            STRING,   -- id_31
  screen             STRING,   -- id_33
  proxy_flag         STRING,   -- id_23: transparent | anonymous | hidden | ""
  device_match_status STRING,  -- id_34
  card_count         INT DEFAULT 0,  -- how many distinct cards used this profile
  first_seen_ts      DATETIME,
  last_seen_ts       DATETIME
) WITH primary_id_as_attribute="true"


CREATE VERTEX EmailDomain (
  PRIMARY_ID domain STRING,
  domain       STRING,
  txn_count    INT DEFAULT 0,
  fraud_count  INT DEFAULT 0
) WITH primary_id_as_attribute="true"


CREATE VERTEX BillingRegion (
  PRIMARY_ID region_code STRING,
  region_code   STRING,
  country_code  STRING,    -- addr2; "87" = home country
  txn_count     INT DEFAULT 0,
  card_count    INT DEFAULT 0
) WITH primary_id_as_attribute="true"


CREATE VERTEX ClosedCase (
  PRIMARY_ID case_id STRING,
  case_id             STRING,
  customer_id         STRING,
  card_id             STRING,
  opened_at           DATETIME,
  closed_at           DATETIME,
  outcome             STRING,   -- "confirmed_fraud" | "cleared"
  pattern             STRING,
  first_fraud_txn_id  STRING,
  txn_ids             STRING,   -- pipe-separated list
  n_txns              INT,
  exposure_usd        FLOAT,
  connected_card_ids  STRING,   -- pipe-separated
  actions_taken       STRING,   -- pipe-separated
  report_filed        BOOL DEFAULT FALSE,
  analyst_notes       STRING,
  -- Vector embedding stored via TigerGraph vector store (analyst_notes + pattern)
  embedding_stored    BOOL DEFAULT FALSE
) WITH primary_id_as_attribute="true"


CREATE VERTEX FraudCase (
  PRIMARY_ID graph_case_id STRING,
  -- Identifiers
  graph_case_id  STRING,   -- e.g. "CASE-2016-1187"
  case_id        STRING,   -- from case_pack (e.g. "HHG-017") or "" for organic
  customer_id    STRING,
  card_id        STRING,

  -- Investigation state
  status         STRING,   -- "open"|"closed_fraud"|"closed_legitimate"|"escalated"
  verdict        STRING,   -- "fraud"|"legitimate"|"uncertain"
  fraud_probability FLOAT,
  pattern        STRING,
  pattern_description STRING DEFAULT "",
  exposure_usd   FLOAT DEFAULT 0.0,
  summary        STRING,
  stop_reason    STRING,

  -- Timestamps
  opened_at      DATETIME,
  closed_at      DATETIME,

  -- JSON blobs (full evidence, actions, SAR — stored for retrieval)
  evidence_json         STRING DEFAULT "[]",
  next_best_actions_json STRING DEFAULT "{}",
  sar_json              STRING DEFAULT "{}",
  evidence_requests_json STRING DEFAULT "[]",

  -- Audit
  tool_calls     INT DEFAULT 0,
  tokens         INT DEFAULT 0,
  latency_s      FLOAT DEFAULT 0.0,
  written_to_graph BOOL DEFAULT TRUE,

  -- Vector embedding of summary for similarity retrieval
  embedding_stored BOOL DEFAULT FALSE
) WITH primary_id_as_attribute="true"


/* ─────────────────────────────────────────────────────────────────────────
   EDGE DEFINITIONS
   ───────────────────────────────────────────────────────────────────────── */

-- Customer owns a card
CREATE DIRECTED EDGE OWNS (FROM Customer, TO Card,
  since DATETIME
) WITH REVERSE_EDGE="OWNED_BY"

-- Card made a transaction
CREATE DIRECTED EDGE MADE (FROM Card, TO Transaction,
  ts DATETIME
) WITH REVERSE_EDGE="MADE_BY"

-- Transaction came from a device profile (online only)
CREATE DIRECTED EDGE FROM_DEVICE (FROM Transaction, TO DeviceProfile,
  device_new   BOOL DEFAULT FALSE,  -- id_15 == "New"
  proxy_used   BOOL DEFAULT FALSE
) WITH REVERSE_EDGE="DEVICE_USED_IN"

-- Transaction purchaser email domain
CREATE DIRECTED EDGE PURCHASER_EMAIL (FROM Transaction, TO EmailDomain)
  WITH REVERSE_EDGE="PURCHASER_TXN"

-- Transaction recipient email domain
CREATE DIRECTED EDGE RECIPIENT_EMAIL (FROM Transaction, TO EmailDomain)
  WITH REVERSE_EDGE="RECIPIENT_TXN"

-- Transaction billed in region
CREATE DIRECTED EDGE BILLED_IN (FROM Transaction, TO BillingRegion,
  addr1 STRING,
  addr2 STRING
) WITH REVERSE_EDGE="REGION_TXN"

-- Chronological chain per card (for burst/sequence detection)
CREATE DIRECTED EDGE NEXT_TXN (FROM Transaction, TO Transaction,
  time_gap_seconds INT  -- ts difference in seconds
)

-- Closed case edges
CREATE DIRECTED EDGE CASE_INVOLVES (FROM ClosedCase, TO Transaction)
CREATE DIRECTED EDGE CASE_ON_CARD (FROM ClosedCase, TO Card)
CREATE DIRECTED EDGE CASE_CONNECTED_TO (FROM ClosedCase, TO Card,
  relationship STRING  -- "ring" | "shared_device" | "shared_region"
)

-- Live / agent-generated case edges
CREATE DIRECTED EDGE LIVE_CASE_INVOLVES (FROM FraudCase, TO Transaction,
  flagged BOOL DEFAULT FALSE
)
CREATE DIRECTED EDGE LIVE_CASE_ON_CARD (FROM FraudCase, TO Card)
CREATE DIRECTED EDGE LIVE_CONNECTED_CARD (FROM FraudCase, TO Card,
  link_reason STRING  -- "shared_device" | "shared_region" | "ring"
)
CREATE DIRECTED EDGE LIVE_CONNECTED_DEV (FROM FraudCase, TO DeviceProfile)

-- Memory link: this live case is similar to a historical closed case
CREATE DIRECTED EDGE SIMILAR_TO (FROM FraudCase, TO ClosedCase,
  similarity_score FLOAT
)
