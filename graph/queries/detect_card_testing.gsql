/*
=============================================================================
  Query: detect_card_testing (Pattern 1 / Policy Rule R5)
=============================================================================
*/

USE GRAPH FraudGraph

DROP QUERY detect_card_testing

CREATE OR REPLACE QUERY detect_card_testing(VERTEX<Transaction> target_txn, INT max_micro_txns = 10) {
  
  TYPEDEF TUPLE<STRING txn_id, FLOAT amt, DATETIME ts, INT time_gap> TXN_STEP;
  
  ListAccum<TXN_STEP> @@chain_steps;
  SetAccum<STRING> @@evidence_ids;
  SumAccum<FLOAT> @@target_amt = 0.0;
  SumAccum<FLOAT> @@model_risk = 0.0;
  SumAccum<STRING> @@channel = "";
  SumAccum<INT> @@micro_count = 0;
  
  StartTxn = {target_txn};
  
  TargetTxn = SELECT t FROM StartTxn:t
              ACCUM 
                @@target_amt += t.TransactionAmt,
                @@model_risk += t.risk_score,
                @@channel += t.channel,
                @@evidence_ids += t.transaction_id;

  # Walk backward along PREV_TXN chain up to max_micro_txns steps
  Curr = TargetTxn;
  WHILE Curr.size() > 0 AND @@chain_steps.size() < max_micro_txns DO
    Curr = SELECT prev_t FROM Curr:curr -(PREV_TXN:e)-> Transaction:prev_t
           WHERE e.time_gap_seconds <= 86400
           ACCUM
             @@chain_steps += TXN_STEP(prev_t.transaction_id, prev_t.TransactionAmt, prev_t.ts, e.time_gap_seconds),
             @@evidence_ids += prev_t.transaction_id,
             IF prev_t.TransactionAmt <= 5.0 THEN
               @@micro_count += 1
             END;
  END;

  FLOAT conf = 0.0;
  STRING risk = "low";
  
  IF @@micro_count >= 3 THEN
    conf = 0.60;
    IF @@target_amt >= 20.0 THEN
      conf = conf + 0.20;
    END;
    conf = conf + (@@model_risk * 0.20);
    IF conf >= 0.75 THEN
      risk = "high";
    ELSE
      risk = "medium";
    END;
  ELSE IF @@micro_count == 2 THEN
    conf = 0.35 + (@@model_risk * 0.20);
    risk = "medium";
  ELSE
    conf = @@model_risk * 0.20;
    risk = "low";
  END;

  IF conf > 1.0 THEN conf = 1.0; END;

  STRING details_json = "{\"rule_ref\":\"R5\",\"micro_txn_count\":" + to_string(@@micro_count) 
                        + ",\"target_amount\":" + to_string(@@target_amt)
                        + ",\"model_risk_score\":" + to_string(@@model_risk)
                        + ",\"channel\":\"" + @@channel + "\"}";

  PRINT "card_testing" AS pattern_name, conf AS confidence_score, risk AS risk_indicator, details_json AS details;
}
