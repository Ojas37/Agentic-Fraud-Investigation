/*
=============================================================================
  Query: detect_fraud_ring (Multi-Account Ring Detection / Rules R6, R9)
  Runs multi-hop expansion across Card, DeviceProfile, and BillingRegion links
  to detect coordinated fraud rings and checks for shared confirmed-fraud history.
=============================================================================
*/

USE GRAPH FraudGraph

DROP QUERY detect_fraud_ring

CREATE OR REPLACE QUERY detect_fraud_ring(VERTEX<Card> target_card, INT max_hops = 2) {
  
  SetAccum<STRING> @@ring_cards;
  SetAccum<STRING> @@ring_customers;
  SetAccum<STRING> @@ring_devices;
  SetAccum<STRING> @@prior_confirmed_cases;
  SetAccum<STRING> @@evidence_ids;
  SumAccum<FLOAT> @@total_ring_exposure = 0.0;
  
  StartCard = {target_card};
  StartCard = SELECT c FROM StartCard:c
              ACCUM 
                @@ring_cards += c.card_id,
                @@ring_customers += c.customer_id,
                @@evidence_ids += c.card_id;

  # Hop 1: Find Transactions and Devices used by StartCard
  Txns = SELECT t FROM StartCard:c -(MADE:e)-> Transaction:t
         ACCUM @@evidence_ids += t.transaction_id,
               @@total_ring_exposure += t.TransactionAmt;

  Devices = SELECT d FROM Txns:t -(FROM_DEVICE:e)-> DeviceProfile:d
            ACCUM @@ring_devices += d.device_profile_id,
                  @@evidence_ids += d.device_profile_id;

  # Hop 2: Find all other Cards sharing these Devices (multi-account fanout)
  ConnectedTxns = SELECT t FROM Devices:d -(DEVICE_USED_IN:e)-> Transaction:t
                  ACCUM @@evidence_ids += t.transaction_id;

  ConnectedCards = SELECT c FROM ConnectedTxns:t -(MADE_BY:e)-> Card:c
                   ACCUM 
                     @@ring_cards += c.card_id,
                     @@ring_customers += c.customer_id,
                     @@evidence_ids += c.card_id;

  # Check for historical confirmed fraud across all ring member cards
  PriorCases = SELECT cc FROM ConnectedCards:c -(CLOSED_CASE_FOR_CARD:e)-> ClosedCase:cc
               WHERE cc.outcome == "confirmed_fraud"
               ACCUM 
                 @@prior_confirmed_cases += cc.case_id,
                 @@evidence_ids += cc.case_id;

  # Normalized Scoring (Policy R6, R9):
  INT num_cards = @@ring_cards.size();
  INT num_cases = @@prior_confirmed_cases.size();
  FLOAT conf = 0.0;
  
  IF num_cards >= 3 THEN
    IF num_cases > 0 THEN
      conf = 0.65 + 0.25;
    ELSE
      conf = 0.65 + 0.10;
    END;
  ELSE IF num_cards == 2 THEN
    IF num_cases > 0 THEN
      conf = 0.40 + 0.30;
    ELSE
      conf = 0.40 + 0.05;
    END;
  ELSE
    IF num_cases > 0 THEN
      conf = 0.35;
    ELSE
      conf = 0.10;
    END;
  END;

  IF conf > 1.0 THEN conf = 1.0; END;
  
  STRING risk = "low";
  IF conf >= 0.70 THEN
    risk = "high";
  ELSE IF conf >= 0.40 THEN
    risk = "medium";
  ELSE
    risk = "low";
  END;

  STRING details_json = "{\"rule_ref\":\"R6,R9\",\"ring_card_count\":" + to_string(num_cards)
                        + ",\"ring_customer_count\":" + to_string(@@ring_customers.size())
                        + ",\"ring_device_count\":" + to_string(@@ring_devices.size())
                        + ",\"prior_confirmed_fraud_cases\":" + to_string(num_cases)
                        + ",\"total_exposure_usd\":" + to_string(@@total_ring_exposure) + "}";

  PRINT "fraud_ring" AS pattern_name, conf AS confidence_score, risk AS risk_indicator, details_json AS details;
}
