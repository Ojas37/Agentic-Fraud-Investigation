/*
=============================================================================
  Query: find_similar_cases_graph (Graph Case Memory / Policy Rule R8)
  Traverses closed case links to find past investigations matching
  the active card, connected cards, or pattern.
=============================================================================
*/

USE GRAPH FraudGraph

DROP QUERY find_similar_cases_graph

CREATE OR REPLACE QUERY find_similar_cases_graph(VERTEX<Card> target_card, STRING pattern_filter = "") {
  
  TYPEDEF TUPLE<STRING case_id, STRING outcome, STRING pattern, FLOAT exposure, STRING analyst_notes> CASE_MATCH;
  
  ListAccum<CASE_MATCH> @@matched_cases;
  SetAccum<STRING> @@evidence_ids;
  SumAccum<INT> @@confirmed_count = 0;
  SumAccum<INT> @@cleared_count = 0;
  
  StartCard = {target_card};

  # Match 1: Direct cases for this card
  DirectCases = SELECT cc FROM StartCard:c -(CLOSED_CASE_FOR_CARD:e)-> ClosedCase:cc
                ACCUM
                  @@matched_cases += CASE_MATCH(cc.case_id, cc.outcome, cc.pattern, cc.exposure_usd, cc.analyst_notes),
                  @@evidence_ids += cc.case_id,
                  IF cc.outcome == "confirmed_fraud" THEN @@confirmed_count += 1
                  ELSE @@cleared_count += 1 END;

  # Match 2: Cases connected via ring/shared links
  ConnectedCases = SELECT cc FROM StartCard:c -(CONNECTED_CLOSED_CASE:e)-> ClosedCase:cc
                   ACCUM
                     @@matched_cases += CASE_MATCH(cc.case_id, cc.outcome, cc.pattern, cc.exposure_usd, cc.analyst_notes),
                     @@evidence_ids += cc.case_id,
                     IF cc.outcome == "confirmed_fraud" THEN @@confirmed_count += 1
                     ELSE @@cleared_count += 1 END;

  INT total_matches = @@matched_cases.size();
  FLOAT conf = 0.0;
  IF total_matches > 0 THEN
    conf = (@@confirmed_count * 1.0) / total_matches;
  END;

  STRING risk = "low";
  IF conf >= 0.70 THEN
    risk = "high";
  ELSE IF conf >= 0.40 THEN
    risk = "medium";
  ELSE
    risk = "low";
  END;

  STRING details_json = "{\"rule_ref\":\"R8\",\"total_matched_cases\":" + to_string(total_matches)
                        + ",\"confirmed_fraud_count\":" + to_string(@@confirmed_count)
                        + ",\"cleared_count\":" + to_string(@@cleared_count) + "}";

  PRINT "case_memory_match" AS pattern_name, conf AS confidence_score, risk AS risk_indicator, details_json AS details;
}
