# ─── TigerGraph ─────────────────────────────────────────────────────────────
TG_HOST=https://your-instance.i.tgcloud.io
TG_USERNAME=tigergraph
TG_PASSWORD=your_tigergraph_password
TG_GRAPH_NAME=FraudGraph
TG_SECRET=your_tigergraph_secret
TG_TOKEN=                          # leave blank; auto-generated from secret

# ─── LLM Provider ───────────────────────────────────────────────────────────
# Set LLM_PROVIDER to: groq | openai | anthropic | google | azure_openai
LLM_PROVIDER=groq
LLM_API_KEY=your_groq_api_key_here
LLM_MODEL=openai/gpt-oss-120b

# ─── TigerGraph MCP ─────────────────────────────────────────────────────────
MCP_SERVER_URL=http://localhost:8000
MCP_LOG_LEVEL=INFO

# ─── GraphRAG / Embeddings ──────────────────────────────────────────────────
EMBEDDING_MODEL=text-embedding-3-small   # or your preferred model
EMBEDDING_PROVIDER=openai                # openai | cohere | google
EMBEDDING_API_KEY=your_embedding_api_key # can reuse LLM_API_KEY

# ─── Application ────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
CASES_OUTPUT_DIR=cases/
DATA_RAW_DIR=data/raw/
DATA_PROCESSED_DIR=data/processed/
